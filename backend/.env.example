# Copia a .env y ajusta
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/volquetas?schema=public"
PORT=3000

# Secreto para firmar los JWT del panel admin (Zona 7). Cambia en producción.
ADMIN_JWT_SECRET=cambia-este-secreto-en-produccion

# URL pública del sitio (para sitemap.xml). Cambia por tu dominio en producción.
SITE_URL=http://localhost:5173

# SMTP para notificar cotizaciones al dueño (opcional; sin esto solo se registra en consola)
# SMTP_HOST=smtp.tudominio.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario@tudominio.com
# SMTP_PASS=clave
# SMTP_FROM=cotizaciones@tudominio.com

# Fotos: si se configuran estas 3, se suben a Cloudinary; si no, a disco local (/uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
